{
  "id": "text-to-image",
  "name": "Tạo ảnh từ mô tả",
  "description": "Tạo ảnh bằng checkpoint ComfyUI đã cài, hỗ trợ negative prompt, kích thước, seed, steps và batch.",
  "inputs": {
    "prompt": {
      "node_id": "6",
      "field": "text",
      "type": "string",
      "max_length": 3000,
      "description": "Mô tả hình ảnh cần tạo"
    },
    "negative_prompt": {
      "node_id": "7",
      "field": "text",
      "type": "string",
      "max_length": 2000,
      "description": "Các đặc điểm cần tránh"
    },
    "steps": {
      "node_id": "3",
      "field": "steps",
      "type": "integer",
      "min": 1,
      "max": 80,
      "description": "Số bước suy luận"
    },
    "seed": {
      "node_id": "3",
      "field": "seed",
      "type": "integer",
      "min": 0,
      "max": 4294967295,
      "description": "Seed cho kết quả lặp lại"
    },
    "width": {
      "node_id": "5",
      "field": "width",
      "type": "integer",
      "min": 256,
      "max": 2048,
      "description": "Chiều rộng ảnh (chia hết cho 8)"
    },
    "height": {
      "node_id": "5",
      "field": "height",
      "type": "integer",
      "min": 256,
      "max": 2048,
      "description": "Chiều cao ảnh (chia hết cho 8)"
    }
  }
}
